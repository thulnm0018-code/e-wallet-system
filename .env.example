DB_HOST=mysql
DB_PORT=3306
DB_NAME=ewallet_db

DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password

JWT_SECRET=your_jwt_secret

JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

SERVER_PORT=8080

CLIENT_URL=http://localhost:3000

# EMAIL / SMTP
# For Gmail, use smtp.gmail.com:587 and an App Password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_smtp_password_or_app_password
MAIL_FROM=your_email@example.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_REQUIRED=true

# OPTIONAL: seed an admin account on first startup.
# These values are only used when the email does not already exist.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_admin_password